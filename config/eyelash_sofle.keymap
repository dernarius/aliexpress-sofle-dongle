#define ZMK_POINTING_DEFAULT_MOVE_VAL 300  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10  // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <0>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };

        middle-mouse-click {
            bindings = <&mkp MCLK>;
            key-positions = <53 54>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        linux {
            bindings = <
&kp GRAVE   &kp N1     &kp N2     &kp N3        &kp N4        &kp N5       &mmv MOVE_UP     &kp N6  &kp N7     &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp TAB     &kp Q      &kp W      &kp E         &kp R         &kp T        &mmv MOVE_DOWN   &kp Y   &kp U      &kp I      &kp O    &kp P     &kp MINUS
&kp CAPS    &kp A      &kp S      &kp D         &kp F         &kp G        &mmv MOVE_LEFT   &kp H   &kp J      &kp K      &kp L    &kp SEMI  &kp APOS
&kp LSHFT   &kp Z      &kp X      &kp C         &kp V         &kp B        &mmv MOVE_RIGHT  &kp N   &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RSHIFT
&kp C_MUTE  &mkp RCLK  &mkp LCLK  &kp LEFT_GUI  &kp LEFT_ALT  &kp SPACE    &none            &mo 1   &kp ENTER  &kp EQUAL  &none    &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "LINUX";
        };

        linux_fn {
            bindings = <
&kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &kp F6    &msc SCRL_UP     &kp F7           &kp F8                &kp F9                 &kp F10           &kp F11            &kp DELETE
&rgb_ug RGB_TOG  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &trans           &trans           &none     &msc SCRL_DOWN   &kp PG_UP        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp F12
&trans           &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &to 2     &msc SCRL_LEFT   &kp PG_DN        &kp LEFT              &kp DOWN               &kp UP_ARROW      &kp RIGHT          &kp BACKSLASH
&trans           &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &to 3     &msc SCRL_RIGHT  &rgb_ug RGB_BRI  &kp HOME              &kp PAGE_DOWN          &kp PG_UP         &kp END            &trans
&trans           &trans           &trans           &trans           &trans           &trans    &none            &trans           &trans                &trans                 &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "LINUX (FN)";
        };

        numpad {
            bindings = <
&none  &none  &none  &none  &none  &none    &none  &kp KP_NUMLOCK   &kp KP_DIVIDE    &kp KP_MULTIPLY  &kp KP_SUBTRACT  &none         &none
&none  &none  &none  &none  &none  &to 0    &none  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS      &none         &none
&none  &none  &none  &none  &none  &none    &none  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS      &none         &none
&none  &none  &none  &none  &none  &to 3    &none  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ENTER     &none         &none
&none  &none  &none  &none  &none  &none    &none  &none            &none            &kp KP_NUMBER_0  &kp KP_COMMA     &kp KP_ENTER
            >;

            display-name = "NUMPAD";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        mac {
            bindings = <
&kp GRAVE  &kp N1     &kp N2     &kp N3   &kp N4        &kp N5       &mmv MOVE_UP     &kp N6  &kp N7     &kp N8     &kp N9        &kp N0     &kp BACKSPACE
&kp TAB    &kp Q      &kp W      &kp E    &kp R         &kp T        &mmv MOVE_DOWN   &kp Y   &kp U      &kp I      &kp O         &kp P      &kp MINUS
&kp CAPS   &kp A      &kp S      &kp D    &kp F         &kp G        &mmv MOVE_LEFT   &kp H   &kp J      &kp K      &kp L         &kp SEMI   &kp APOS
&kp LSHFT  &kp Z      &kp X      &kp C    &kp V         &kp B        &mmv MOVE_RIGHT  &kp N   &kp M      &kp COMMA  &kp DOT       &kp FSLH   &kp RSHIFT
&kp LCMD   &mkp RCLK  &mkp LCLK  &kp F17  &kp LEFT_GUI  &kp SPACE    &none            &mo 4   &kp ENTER  &kp EQUAL  &kp LEFT_ALT  &kp LCTRL
            >;

            sensor-bindings = <&inc_dec_kp (TAB) LS(TAB)>;
            display-name = "MAC";
        };

        mac_fn {
            bindings = <
&kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &kp F6    &msc SCRL_UP     &kp F7           &kp F8                &kp F9                 &kp F10           &kp F11            &kp DELETE
&rgb_ug RGB_TOG  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &trans           &trans           &to 0     &msc SCRL_DOWN   &kp PG_UP        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp F12
&trans           &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &to 2     &msc SCRL_LEFT   &kp PG_DN        &kp LEFT              &kp DOWN               &kp UP_ARROW      &kp RIGHT          &kp BACKSLASH
&trans           &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &none     &msc SCRL_RIGHT  &rgb_ug RGB_BRI  &kp HOME              &kp PAGE_DOWN          &kp PG_UP         &kp END            &trans
&trans           &trans           &trans           &trans           &trans           &trans    &none            &trans           &trans                &trans                 &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp (TAB) LS(TAB)>;
            display-name = "MAC (FN)";
        };
    };
};
